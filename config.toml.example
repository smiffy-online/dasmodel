# DasModel configuration

[ollama]
url = "http://localhost:11434"
model = "qwen3-coder-next:cloud"
# api_key = ""   # Required for Ollama Cloud direct API (https://ollama.com)

[server]
host = "0.0.0.0"
port = 5004
debug = false

[database]
path = "dasmodel.db"

[agent]
max_tool_iterations = 10
default_user = "smiffy"
# Unique identity for this DasModel instance, used in state updates and scratchpads.
# Set this to distinguish instances when multiple run on the same host.
# Convention: "dm-<purpose or host>-<descriptor>" e.g. "dm-dolly-misti", "dm-dolly-coder"
# author_id = ""

# Static asset paths (relative to static/ directory)
# Download Bootstrap and place in static/vendor/bootstrap/
[static]
bootstrap_css = "/static/vendor/bootstrap/css/bootstrap.min.css"
bootstrap_js = "/static/vendor/bootstrap/js/bootstrap.bundle.min.js"

# Built-in shell tool. Disabled by default — enable explicitly.
[shell]
enabled = true
working_directory = "/home/agent/work"
timeout = 30
max_output_chars = 50000
# Restrict shell to specific directories (empty = no restriction)
allowed_directories = ["/home/agent", "/tmp"]

# Expose DasModel itself as an MCP server at /mcp/
# Allows external agents to chat, correct, and manage rules/prompts.
[mcp_server]
enabled = true

# MCP servers for tool access. Add as many as needed.
# Each server is queried for available tools at conversation start.
# Remove or comment out all [[mcp]] entries to run without tools.

[[mcp]]
name = "misti"
url = "https://misti-mcp.cougar-grue.ts.net"
