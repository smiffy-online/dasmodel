[Unit]
Description=DasModel Agent Runtime
After=network.target

[Service]
User=agent
WorkingDirectory=/home/agent/dasmodel
ExecStart=/home/agent/dasmodel/venv/bin/gunicorn -w 2 -k gthread --threads 4 --timeout 180 -b 0.0.0.0:5003 main:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
